# Production process environment. Copy to the host. Do not commit the copy.
# No session tokens, database passwords, or real payment keys belong here.

MD_ENV=production
MD_HOST=0.0.0.0
MD_PORT=8741
MD_PUBLIC_API_URL=https://api.example.com
MD_PUBLIC_WS_URL=wss://api.example.com
MD_CORS_ORIGINS=https://play.example.com
MD_DATABASE_PATH=/data/market.db
MD_LOG_LEVEL=info
MD_GRACE_SECONDS=120
MD_DEADLINE_POLL_SECONDS=2
MD_SESSION_TTL_SECONDS=86400
MD_ROOM_CREATE_LIMIT=30
MD_COMMAND_LIMIT=80
