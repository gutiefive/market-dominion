# Copy to a host environment or a local .env that you do not commit.
# The API reads process environment variables. It does not load this file.

# SQLite file used when DATABASE_URL is unset.
MD_DATABASE_PATH=server/data/market.db

# sqlite:///relative.db or sqlite:////absolute/market.db
# postgres:// and postgresql:// are rejected at startup.
# The process does not open PostgreSQL. See infra/migrations/0001_rooms.sql.
# DATABASE_URL=sqlite:////data/market.db

# Directory that contains shared/. Unset in a checkout. The image sets /app.
# MD_REPO_ROOT=/app

MD_HOST=127.0.0.1
MD_PORT=8741
MD_LOG_LEVEL=info

# Comma-separated browser origins. Leave empty for the desktop Godot client.
# A hosted page must list its exact origin, for example:
# MD_CORS_ORIGINS=http://127.0.0.1:8097,http://localhost:8097

# local, container, staging, or production.
# production requires https:// MD_PUBLIC_API_URL, wss, and MD_CORS_ORIGINS.
# MD_ENV=local

# Public API the browser should use. The web page reads this from md-config.js
# or from ?server=. Do not put a session token in either place.
# MD_PUBLIC_API_URL=https://api.example.com
# MD_PUBLIC_WS_URL=wss://api.example.com

# Seconds before a disconnected active seat takes the safe action.
# MD_GRACE_SECONDS=120
# How often the server checks those deadlines without waiting for a command.
# MD_DEADLINE_POLL_SECONDS=2
# Idle session lifetime. Activity refreshes it. Minimum 60.
# MD_SESSION_TTL_SECONDS=86400
# MD_ROOM_CREATE_LIMIT=30
# MD_COMMAND_LIMIT=80

# Local web export smoke port used by scripts/smoke_web.sh
MD_WEB_PORT=8097
